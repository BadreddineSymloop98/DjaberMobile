<?xml version="1.0" encoding="utf-8"?>
<!--
  The window background while the process starts, before Flutter paints.

  True black, matching AppColors.ink. The template's default was white, which
  on a black app is a full-screen flash on every cold start — the first thing
  a merchant sees, and it reads as a bug rather than as a launch.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ink" />
    <item android:drawable="@drawable/djaber_mark" android:gravity="center" />
</layer-list>

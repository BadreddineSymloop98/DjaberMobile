<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The app is dark-only — the web has no light mode and the palette is built
      on true black — so light and night resolve to the same thing. values-night
      is kept identical rather than deleted, so a future light theme has a place
      to go.
    -->

    <!-- Shown while the process starts, until Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Applied once the process is up, and sits behind the Flutter UI. Black
         rather than ?android:colorBackground, which is white on a light OS and
         shows through as a flash during any window resize. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ink</item>
    </style>
</resources>
